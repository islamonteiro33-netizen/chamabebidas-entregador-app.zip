{
  "expo": {
    "name": "Chama Entregador",
    "slug": "chama-entregador-v22-osm",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090C"
    },
    "android": {
      "package": "com.chamabebidas.entregador",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#08090C"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-location"
    ]
  }
}
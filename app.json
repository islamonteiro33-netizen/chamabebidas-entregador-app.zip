{
  "expo": {
    "name": "Chama Entregador",
    "slug": "chama-entregador-99",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080A"
    },
    "android": {
      "package": "com.chamabebidas.entregador",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#08080A"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-image-picker"
    ]
  }
}